RAW_DIR = DATA_DIR / "raw"


# ==================================================
# CHECKPOINT
# ==================================================

def empty_state():
    return {
        "completed": [],
        "failed": [],
        "batch_num": 0,
    }


def load_checkpoint():
    if not CHECKPOINT_FILE.exists():
        return empty_state()

    try:
        with CHECKPOINT_FILE.open(
            "r",
            encoding="utf-8"
        ) as f:
            state = json.load(f)

        if not isinstance(state, dict):
            raise ValueError("Checkpoint must be a JSON object")

        completed = state.get("completed", [])
        failed = state.get("failed", [])
        batch_num = state.get("batch_num", 0)

        if not isinstance(completed, list):
            raise ValueError("Invalid completed list")

        if not isinstance(failed, list):
            raise ValueError("Invalid failed list")

        if (
            not isinstance(batch_num, int)
            or isinstance(batch_num, bool)
            or batch_num < 0
        ):
            raise ValueError("Invalid batch_num")

        # Preserve all existing completed symbols.
        completed = list(
            dict.fromkeys(str(x) for x in completed)
        )

        valid_failed = []

        for item in failed:
            if isinstance(item, dict) and item.get("ins_code"):
                valid_failed.append(item)

        state["completed"] = completed
        state["failed"] = valid_failed
        state["batch_num"] = batch_num

        return state

    except Exception as exc:
        raise RuntimeError(
            f"Checkpoint load failed: {exc}. "
            "Original checkpoint was not modified."
        ) from exc


def save_checkpoint(state):
    CHECKPOINT_FILE.parent.mkdir(
        parents=True,
        exist_ok=True
    )

    fd, temp_name = tempfile.mkstemp(
        prefix="batch_checkpoint_",
        suffix=".tmp",
        dir=str(CHECKPOINT_FILE.parent),
    )

    try:
        with os.fdopen(
            fd,
            "w",
            encoding="utf-8"
        ) as f:
            json.dump(
                state,
                f,
                ensure_ascii=False,
                indent=2
            )
            f.flush()
            os.fsync(f.fileno())

        os.replace(
            temp_name,
            CHECKPOINT_FILE
        )

    except Exception:
        try:
            os.unlink(temp_name)
        except OSError:
            pass

        raise


def mark_completed(state, ins_code):
    ins_code = str(ins_code)

    if ins_code not in state["completed"]:
        state["completed"].append(ins_code)

    state["failed"] = [
        item
        for item in state["failed"]
        if str(item.get("ins_code")) != ins_code
    ]


def mark_failed(state, ins_code, symbol, error):
    ins_code = str(ins_code)

    state["failed"] = [
        item
        for item in state["failed"]
        if str(item.get("ins_code")) != ins_code
    ]

    state["failed"].append({
        "ins_code": ins_code,
        "symbol": str(symbol),
        "error": str(error),
        "updated_at": datetime.now(
            timezone.utc
        ).isoformat(timespec="seconds"),
    })


# ==================================================
# DATABASE
# ==================================================

def get_all_symbols():
    if not DB_PATH.exists():
        raise FileNotFoundError(
            f"Database does not exist: {DB_PATH}"
        )

    con = sqlite3.connect(
        DB_PATH,
        timeout=15
    )

    try:
        con.row_factory = sqlite3.Row
        con.execute("PRAGMA busy_timeout=15000")

        rows = con.execute("""
            SELECT ins_code, symbol
            FROM symbols
            ORDER BY trades DESC
        """).fetchall()

        return [
            {
                "ins_code": str(row["ins_code"]),
                "symbol": str(row["symbol"]),
            }
            for row in rows
        ]

    finally:
        con.close()


def to_number(value):
    if value is None or value == "":
        return 0.0

    result = float(value)

    if not math.isfinite(result):
        raise ValueError("Non-finite numeric value")

    return result


def save_to_db(ins_code, records):
    """
    Insert history without overwriting existing records.
    Returns the actual number of inserted rows.
    """

    if not records:
        return 0

    now = datetime.now(
        timezone.utc
    ).isoformat(timespec="seconds")

    con = sqlite3.connect(
        DB_PATH,
        timeout=15
    )

    inserted = 0

    try:
        con.execute("PRAGMA busy_timeout=15000")

        with con:
            for raw in records:

                if not isinstance(raw, dict):
                    continue

                try:
                    date = int(raw.get("dEven", 0))

                    if date <= 0:
                        continue

                    values = (
                        str(ins_code),
                        date,
                        to_number(raw.get("pClosing")),
                        to_number(raw.get("pDrCotVal")),
                        to_number(raw.get("priceMin")),
                        to_number(raw.get("priceMax")),
                        to_number(raw.get("priceFirst")),
                        to_number(raw.get("priceYesterday")),
                        to_number(raw.get("priceChange")),
                        to_number(raw.get("qTotTran5J")),
                        to_number(raw.get("qTotCap")),
                        to_number(raw.get("zTotTran")),
                        "batch",
                        now,
                    )

                except (
                    TypeError,
                    ValueError,
                    OverflowError
                ):
                    continue

                cursor = con.execute("""
                    INSERT INTO price_history (
                        ins_code,
                        date,
                        price_close,
                        price_last,
                        price_min,
                        price_max,
                        price_first,
                        price_yesterday,
                        price_change,
                        volume,
                        value,
                        trades,
                        source,
                        inserted_at
                    )
                    VALUES (
                        ?, ?, ?, ?, ?, ?, ?, ?,
                        ?, ?, ?, ?, ?, ?
                    )
                    ON CONFLICT(ins_code, date) DO NOTHING
                """, values)

                if cursor.rowcount == 1:
                    inserted += 1

        return inserted

    finally:
        con.close()


# ==================================================
# RAW JSON BACKUP
# ==================================================

def save_raw_json(ins_code, records):
    RAW_DIR.mkdir(
        parents=True,
        exist_ok=True
    )

    path = RAW_DIR / f"{ins_code}.json"

    payload = {
        "closingPriceDaily": records
    }

    if path.exists():
        try:
            with path.open(
                "r",
                encoding="utf-8"
            ) as f:
                old_data = json.load(f)

            if old_data == payload:
                return

        except Exception:
            pass

        timestamp = datetime.now(
            timezone.utc
        ).strftime("%Y%m%d_%H%M%S_%f")

        backup_path = RAW_DIR / (
            f"{ins_code}.backup_{timestamp}.json"
        )

        shutil.copy2(path, backup_path)

    fd, temp_name = tempfile.mkstemp(
        prefix=f"{ins_code}_",
        suffix=".tmp",
        dir=str(RAW_DIR)
    )

    try:
        with os.fdopen(
            fd,
            "w",
            encoding="utf-8"
        ) as f:
            json.dump(
                payload,
                f,
                ensure_ascii=False
            )
            f.flush()
            os.fsync(f.fileno())

        os.replace(temp_name, path)

    except Exception:
        try:
            os.unlink(temp_name)
        except OSError:
            pass

        raise


# ==================================================
# NETWORK
# ==================================================

def fetch_with_retry(session, url):
    for attempt in range(1, MAX_RETRIES + 1):

        try:
            response = session.get(
                url,
                timeout=TIMEOUT_DAILY_LIST
            )

            status = response.status_code

            if status in STOP_STATUS_CODES:
                return None, f"STOP_{status}"

            if status in RETRY_STATUS_CODES:
                if attempt < MAX_RETRIES:
                    wait = RETRY_BACKOFF_BASE ** attempt

                    print(
                        f"[retry {attempt}] "
                        f"HTTP {status}; waiting {wait}s"
                    )

                    time.sleep(wait)
                    continue

                return None, f"HTTP_{status}"

            response.raise_for_status()

            data = response.json()

            if not isinstance(data, dict):
                return None, "INVALID_STRUCTURE"

            records = data.get("closingPriceDaily")

            if not isinstance(records, list):
                return None, "INVALID_STRUCTURE"

            if not records:
                return None, "EMPTY_RESPONSE"

            return records, None

        except requests.exceptions.Timeout:
            if attempt < MAX_RETRIES:
                time.sleep(
                    RETRY_BACKOFF_BASE ** attempt
                )
                continue

            return None, "TIMEOUT"

        except requests.exceptions.ConnectionError:
            if attempt < MAX_RETRIES:
                time.sleep(
                    RETRY_BACKOFF_BASE ** attempt
                )
                continue

            return None, "CONNECTION_ERROR"

        except requests.exceptions.HTTPError as exc:
            status = (
                exc.response.status_code
                if exc.response is not None
                else "UNKNOWN"
            )

            return None, f"HTTP_ERROR_{status}"

        except requests.exceptions.RequestException as exc:
            if attempt < MAX_RETRIES:
                time.sleep(
                    RETRY_BACKOFF_BASE ** attempt
                )
                continue

            return None, f"REQUEST_ERROR: {exc}"

        except ValueError as exc:
            return None, f"INVALID_JSON: {exc}"

        except Exception as exc:
            return None, f"UNEXPECTED_ERROR: {exc}"

    return None, "MAX_RETRIES_EXCEEDED"


# ==================================================
# BATCH PROCESSING
# ==================================================


def _count_valid_history_records(records):
    """
    Count records that can actually be normalized for database insertion.
    Duplicate valid records are still considered valid.
    """

    numeric_fields = (
        "pClosing",
        "pDrCotVal",
        "priceMin",
        "priceMax",
        "priceFirst",
        "priceYesterday",
        "priceChange",
        "qTotTran5J",
        "qTotCap",
        "zTotTran",
    )

    valid_count = 0

    for raw in records:
        if not isinstance(raw, dict):
            continue

        try:
            date = int(raw.get("dEven", 0))

            if date <= 0:
                continue

            for field in numeric_fields:
                to_number(raw.get(field))

            valid_count += 1

        except (TypeError, ValueError, OverflowError):
            continue

    return valid_count


def process_batch(batch, state, session):
    success = 0
    failed = 0
    stopped = False

    for index, sym in enumerate(batch, 1):

        ins_code = sym["ins_code"]
        symbol = sym["symbol"]

        print(
            f"[{index}/{len(batch)}] "
            f"{symbol:15s} ...",
            end=" ",
            flush=True
        )

        url = (
            f"{TSETMC_BASE}/ClosingPrice/"
            f"GetClosingPriceDailyList/{ins_code}/0"
        )

        records, error = fetch_with_retry(
            session,
            url
        )

        if error and error.startswith("STOP_"):
            print(f"STOPPED: {error}")

            mark_failed(
                state,
                ins_code,
                symbol,
                error
            )

            save_checkpoint(state)
            stopped = True
            break

        if error:
            mark_failed(
                state,
                ins_code,
                symbol,
                error
            )

            failed += 1

            print(f"FAILED: {error}")

            save_checkpoint(state)
            time.sleep(DELAY_BETWEEN_SYMBOLS)
            continue

        try:
            valid_count = _count_valid_history_records(records)

            if valid_count == 0:
                raise ValueError(
                    "API response contains no valid history records"
                )

            saved = save_to_db(
                ins_code,
                records
            )

            save_raw_json(
                ins_code,
                records
            )

            mark_completed(
                state,
                ins_code
            )

            success += 1

            print(
                f"SUCCESS | Valid API rows: {valid_count} "
                f"| New DB rows: {saved}"
            )

        except Exception as exc:
            mark_failed(
                state,
                ins_code,
                symbol,
                f"SAVE_ERROR: {exc}"
            )

            failed += 1

            print(f"SAVE ERROR: {exc}")

        save_checkpoint(state)

        time.sleep(DELAY_BETWEEN_SYMBOLS)

    return success, failed, stopped


# ==================================================
# MAIN
# ==================================================

def main():
    print("=" * 65)
    print("BEHZAD_AI - BATCH HISTORY DOWNLOADER")
    print("=" * 65)

    print(f"Project: {BASE_DIR}")
    print(f"Database: {DB_PATH}")
    print(f"Checkpoint: {CHECKPOINT_FILE}")
    print(f"Batch size: {BATCH_SIZE}")
    print(f"Retries: {MAX_RETRIES}")
    print()

    state = load_checkpoint()
    symbols = get_all_symbols()

    completed_set = set(state["completed"])

    pending = [
        symbol
        for symbol in symbols
        if symbol["ins_code"] not in completed_set
    ]

    print(f"Total symbols: {len(symbols)}")
    print(f"Completed: {len(completed_set)}")
    print(f"Failed records: {len(state['failed'])}")
    print(f"Pending: {len(pending)}")
    print()

    if not pending:
        print("No pending symbols.")
        return

    batch = pending[:BATCH_SIZE]

    state["batch_num"] += 1
    save_checkpoint(state)

    print(
        f"Starting batch #{state['batch_num']} "
        f"with {len(batch)} symbols"
    )

    session = requests.Session()
    session.headers.update(HEADERS)

    try:
        success, failed, stopped = process_batch(
            batch,
            state,
            session
        )

    finally:
        session.close()

    save_checkpoint(state)

    print()
    print("=" * 65)
    print("BATCH SUMMARY")
    print("=" * 65)
    print(f"Success: {success}")
    print(f"Failed: {failed}")
    print(f"Completed total: {len(state['completed'])}")
    print(f"Remaining: {max(0, len(pending) - success)}")
    print(f"Stopped: {stopped}")
    print("=" * 65)


if __name__ == "__main__":
    main()

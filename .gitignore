# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Database files (do not commit)
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite3
data/*.sqlite3-shm
data/*.sqlite3-wal

# Large raw data (too many files)
data/raw/
data/market_watch_raw.json
data/history_*_raw.json

# Keep useful data
!data/.gitkeep
!data/symbols.json
!data/top_setups.json
!data/market_breakdown.json

# Logs
*.log
data/downloader.log

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Backups
*.bak
*.backup
